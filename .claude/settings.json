{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/credentials*.json)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(more .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(Get-Content .env*)",
      "mcp__Interactive_Brokers_IBKR__get_order_instructions",
      "mcp__alpaca__close_all_positions",
      "mcp__alpaca__cancel_all_orders",
      "mcp__alpaca__place_option_order",
      "mcp__alpaca__place_crypto_order",
      "mcp__alpaca__exercise_options_position",
      "mcp__alpaca__do_not_exercise_options_position",
      "mcp__alpaca__update_account_config"
    ],
    "ask": [
      "mcp__alpaca__place_stock_order",
      "mcp__alpaca__replace_order_by_id",
      "mcp__alpaca__cancel_order_by_id",
      "mcp__alpaca__close_position",
      "mcp__Interactive_Brokers_IBKR__create_saved_screener",
      "mcp__Interactive_Brokers_IBKR__update_saved_screener",
      "mcp__Interactive_Brokers_IBKR__delete_saved_screener"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*([Aa][Ll][Pp][Aa][Cc][Aa]|[Ii][Nn][Tt][Ee][Rr][Aa][Cc][Tt][Ii][Vv][Ee]_[Bb][Rr][Oo][Kk][Ee][Rr][Ss]|[Ii][Bb][Kk][Rr]).*|Edit|MultiEdit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/broker_guard.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/broker_guard.py\""
          }
        ]
      }
    ]
  }
}
